# Вход в панель
PANEL_USER=admin
PANEL_PASSWORD=
# Любая длинная случайная строка, чтобы вход не слетал после перезапуска
SESSION_SECRET=

PORT=3003
# HOST=0.0.0.0
# DB_PATH=/var/lib/nyamnyam-promo/promo.db

# Прокси для t.me, если с сервера он не открывается (например http://host:8888)
TG_PROXY=
# Пауза между каналами при массовом сборе, секунд
FETCH_PAUSE=3

# ИИ-анализ: любой OpenAI-совместимый API. Пусто = анализ выключен
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=100
